{
  "name": "abyssan",
  "version": "1.0.0",
  "private": true,
  "description": "Abyssan — cliente Git gráfico auto-hospedable, inspirado en GitKraken",
  "scripts": {
    "dev:server": "pnpm --filter @abyssan/server dev",
    "dev:web": "pnpm --filter @abyssan/web dev",
    "dev": "pnpm --filter @abyssan/server dev & pnpm --filter @abyssan/web dev",
    "build": "pnpm --filter @abyssan/server build && pnpm --filter @abyssan/web build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "git",
    "abyssan",
    "git-gui",
    "react19",
    "vite",
    "typescript"
  ],
  "author": "Kevin Austria",
  "license": "MIT",
  "devDependencies": {
    "oxlint": "^0.15.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
