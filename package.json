{
  "name": "abyssan",
  "version": "1.0.0",
  "private": true,
  "description": "Abyssan — cliente Git gráfico auto-hospedable, inspirado en GitKraken",
  "scripts": {
    "dev:server": "pnpm --filter @abyssan/server dev",
    "dev:web": "pnpm --filter @abyssan/web dev",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @abyssan/server build && pnpm --filter @abyssan/web build",
    "lint": "oxlint",
    "typecheck": "pnpm --filter @abyssan/server exec tsc --noEmit && pnpm --filter @abyssan/web exec tsc --noEmit",
    "test": "vitest run",
    "test:seguridad": "vitest run apps/server/src/infrastructure/seguridad apps/server/src/infrastructure/ws apps/server/src/application/__tests__/refsPerimetro.test.ts apps/server/src/application/__tests__/addRemotePerimetro.test.ts apps/server/src/application/__tests__/previewPerimetro.test.ts",
    "test:watch": "vitest"
  },
  "keywords": [
    "git",
    "abyssan",
    "git-gui",
    "react19",
    "vite",
    "typescript"
  ],
  "author": "Kevin Austria",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "oxlint": "^0.15.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
