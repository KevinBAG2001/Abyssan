# Abyssan — variables de entorno del servidor
PORT=3001
NODE_ENV=development

# Bind localhost por defecto (D15). Si no es loopback, ABYSSAN_API_TOKEN es obligatorio.
BIND_HOST=127.0.0.1

# Directorio raíz donde se listan y operan repositorios Git. Única frontera de filesystem.
# Windows: C:/Users/tu_usuario/proyectos  (barras / recomendadas también en Windows)
# Linux/Docker: /workspace/proyectos
PROJECTS_ROOT=C:/Users/tu_usuario/proyectos

# Orígenes de la SPA permitidos en CORS y en mutaciones POST (lista separada por comas).
# CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Frontend (Vite) — prefijo VITE_
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# Token de instancia (lo generas tú; no viene de GitHub ni de ningún portal).
# Obligatorio con docker compose (el contenedor escucha 0.0.0.0).
# Obligatorio en local solo si BIND_HOST no es 127.0.0.1 / localhost / ::1.
#
# Regla: el MISMO valor en ambas variables.
#   ABYSSAN_API_TOKEN       → lo valida el servidor (Bearer en /api/*).
#   VITE_ABYSSAN_API_TOKEN  → lo envía la SPA (queda en el bundle de Vite).
#
# Generar uno aleatorio (elige un método):
#   PowerShell:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#   Linux/macOS: openssl rand -base64 32
#
# Ejemplo (sustituye por tu propio secreto; no uses este en producción):
# ABYSSAN_API_TOKEN=tu-secreto-largo-y-aleatorio-aqui
# VITE_ABYSSAN_API_TOKEN=tu-secreto-largo-y-aleatorio-aqui
#
# ABYSSAN_API_TOKEN=
# VITE_ABYSSAN_API_TOKEN=

# Volumen de proyectos en Compose (ruta en el host). Debe apuntar al mismo directorio que PROJECTS_ROOT.
# Por defecto el checkout de Abyssan (.). Tras cambiarla: docker compose up -d --force-recreate server
# ABYSSAN_PROJECTS_HOST=C:/Users/tu_usuario/proyectos

# Identidad Git del host para Docker (solo lectura). Git dentro del contenedor no lee
# tu ~/.gitconfig solo: hay que montarlo. El path debe ser un ARCHIVO, no una carpeta.
# Al arrancar se copian solo user.name y user.email; no se importan safe.directory ni helpers.
# Windows: C:/Users/tu_usuario/.gitconfig
# Linux/macOS: /home/tu_usuario/.gitconfig
# ABYSSAN_GITCONFIG_HOST=C:/Users/tu_usuario/.gitconfig

# Persistencia de Abyssan en Docker (journal, OAuth cifrado). Si omites esto,
# Compose usa el volumen nombrado abyssan-home.
# ABYSSAN_HOME_HOST=C:/Users/tu_usuario/.abyssan

# OAuth credenciales git (Fase 1.2 — D5b-A). Sin esto, el clone público HTTPS sigue funcionando.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# OAUTH_CALLBACK_URL=http://localhost:3001/api/auth/callback
# ABYSSAN_SECRETO_CIFRADO=

# Alternativa a OAuth para push/fetch HTTPS en Docker (no uses las credenciales de Windows:
# el contenedor no las ve). PAT con alcance repo. Crear:
# https://github.com/settings/tokens/new?scopes=repo&description=Abyssan
# Pega el valor a la derecha del =, sin comillas. Recrea el server de Compose.
# ABYSSAN_GITHUB_TOKEN=
# ABYSSAN_GITLAB_TOKEN=
