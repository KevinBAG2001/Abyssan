# WebKraken — variables de entorno del servidor
PORT=3001
NODE_ENV=development

# Directorio raíz donde se listan y operan repositorios Git
# Windows: C:\Users\tu_usuario\proyectos
# Linux/Docker: /workspace/proyectos
PROJECTS_ROOT=C:\Users\kevin.austria\proyectos

# Frontend (Vite) — prefijo VITE_
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# OAuth (fase 3 — opcional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# OAUTH_CALLBACK_URL=http://localhost:3001/api/auth/callback
